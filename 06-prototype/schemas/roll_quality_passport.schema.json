{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/darm/roll-quality-passport.schema.json",
  "title": "Roll Quality Passport",
  "description": "Synthetic-safe contract for a roll-level quality record. Real operational data must remain in approved company infrastructure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "passport_id",
    "roll",
    "order_context",
    "production",
    "inspection",
    "quality",
    "disposition",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "passport_id": {
      "type": "string",
      "minLength": 1
    },
    "roll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_roll_id", "source_roll_ids", "roll_type"],
      "properties": {
        "canonical_roll_id": {"type": "string", "minLength": 1},
        "source_roll_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "value"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1}
            }
          }
        },
        "roll_type": {
          "type": "string",
          "enum": ["parent", "child", "standalone", "rework"]
        },
        "parent_roll_id": {"type": ["string", "null"]},
        "length_m": {"type": ["number", "null"], "minimum": 0},
        "width_mm": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "order_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sales_order_id", "production_order_id", "article_id", "product_family"],
      "properties": {
        "sales_order_id": {"type": ["string", "null"]},
        "production_order_id": {"type": ["string", "null"]},
        "article_id": {"type": "string", "minLength": 1},
        "product_family": {"type": "string", "minLength": 1},
        "customer_spec_id": {"type": ["string", "null"]}
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "role"],
        "properties": {
          "material_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "enum": ["substrate", "binder", "filler", "additive", "pigment", "foil", "adhesive", "other"]},
          "supplier_lot": {"type": ["string", "null"]}
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "started_at", "ended_at", "recipe_version", "parameters"],
      "properties": {
        "line_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "recipe_version": {"type": ["string", "null"]},
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "unit", "value_kind"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "value": {"type": ["number", "string", "null"]},
              "unit": {"type": ["string", "null"]},
              "value_kind": {"type": "string", "enum": ["setpoint", "actual", "manual", "derived"]}
            }
          }
        },
        "deviations": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "events"],
      "properties": {
        "system": {"type": ["string", "null"]},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "defect_code", "severity", "decision", "cause_status"],
            "properties": {
              "event_id": {"type": "string", "minLength": 1},
              "defect_code": {"type": "string", "minLength": 1},
              "source_label": {"type": ["string", "null"]},
              "severity": {"type": "string", "enum": ["S0", "S1", "S2", "S3", "S4"]},
              "decision": {"type": "string", "enum": ["accepted", "rejected", "ignored", "reclassified", "review"]},
              "cause_status": {"type": "string", "enum": ["observed_only", "suspected", "supported", "confirmed"]},
              "suspected_cause": {"type": ["string", "null"]},
              "position_m": {"type": ["number", "null"], "minimum": 0},
              "recorded_at": {"type": ["string", "null"], "format": "date-time"},
              "image_reference": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "release_status"],
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test_id", "method", "result_status"],
            "properties": {
              "test_id": {"type": "string", "minLength": 1},
              "method": {"type": "string", "minLength": 1},
              "value": {"type": ["number", "string", "null"]},
              "unit": {"type": ["string", "null"]},
              "lower_limit": {"type": ["number", "null"]},
              "upper_limit": {"type": ["number", "null"]},
              "result_status": {"type": "string", "enum": ["pass", "fail", "retest", "not_applicable", "unknown"]},
              "tested_at": {"type": ["string", "null"], "format": "date-time"}
            }
          }
        },
        "release_status": {
          "type": "string",
          "enum": ["released", "held", "reworked", "scrapped", "conditionally_released", "unknown"]
        },
        "release_reason": {"type": ["string", "null"]}
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_disposition"],
      "properties": {
        "final_disposition": {
          "type": "string",
          "enum": ["ship", "hold", "rework", "scrap", "downgrade", "investigate", "unknown"]
        },
        "rework_quantity_m": {"type": ["number", "null"], "minimum": 0},
        "scrap_quantity_m": {"type": ["number", "null"], "minimum": 0},
        "complaint_id": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "source_systems", "linkage_level", "linkage_confidence", "synthetic"],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "source_systems": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "linkage_level": {"type": "string", "enum": ["A", "B", "C", "D"]},
        "linkage_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "missing_domains": {
          "type": "array",
          "items": {"type": "string"}
        },
        "synthetic": {"type": "boolean", "const": true}
      }
    }
  }
}
